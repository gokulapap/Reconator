# Reconator 3 config — copy to .env for Docker Compose.
# Never commit the resulting .env file.

# Required by docker-compose.yaml. Generate long, unique values before launch.
ADMIN_API_KEY=replace-with-a-random-api-key
POSTGRES_PASSWORD=replace-with-a-random-database-password
TOOLBOX_SHARED_SECRET=replace-with-an-independent-random-toolbox-secret

# Database
POSTGRES_USER=reconator
POSTGRES_DB=reconator

# Network exposure (loopback by default)
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,reconator.local,api
PROTECT_READ_ENDPOINTS=true

# Execution safety and capacity
ALLOW_PRIVATE_TARGETS=false
WORKER_REPLICAS=2
TOOLBOX_MAX_CONCURRENT=4
MAX_CONCURRENT_TASKS=2
MAX_CONCURRENT_TASKS_PER_TARGET=2
MAX_TASKS_PER_SCAN=10000
MAX_ASSET_EMISSIONS_PER_TASK=20000
MAX_RELATIONSHIP_EMISSIONS_PER_TASK=20000
MAX_EMISSION_METADATA_BYTES=65536
MAX_RAW_OUTPUT_BYTES=2000000
MAX_RAW_OUTPUT_BYTES_PER_SCAN=50000000
MAX_REQUEST_BODY_BYTES=1000000
TASK_LEASE_SECONDS=180
WORKER_POLL_INTERVAL_SECONDS=2
RATE_LIMIT_WRITES=20/minute
RATE_LIMIT_BULK=5/minute

# Telegram notifications (optional — leave blank to disable)
TELEGRAM_API_KEY=
TELEGRAM_CHAT_ID=

# Webhook notifications (optional)
# WEBHOOK_KIND: generic | slack | discord
WEBHOOK_URL=
WEBHOOK_KIND=generic
ALLOW_PRIVATE_WEBHOOKS=false

# Observability
SENTRY_DSN=

# Optional deployment controls
APP_ENV=production
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
RECONATOR_VERSION=local
